---
const {comentario, nombre} = Astro.props
---

<div class="w-[400px] min-h-60 bg-[#15170f] rounded-xl flex flex-col gap-5 justify-center box-border p-10 border border-white/10 shadow transition-colors duration-200 hover:border-lime-300 bg-red">
    <div class="text-lime-400">★★★★★</div>
    <p>"{comentario}"</p>
    <div class="flex flex-col">
        <b class="text-sm">{nombre}</b>
        <span class="text-sm text-zinc-400">Reseña verificada en Google</span>
    </div>
</div>